{
  "manifestVersion": 4,
  "apiVersion": "1.0",
  "id": "vibex-canvas",
  "publisher": "luochinwen",
  "version": "0.1.0",
  "name": "生图画板",
  "readme": "README.md",
  "engines": {
    "vibex": ">=0.1.3 <1.0.0",
    "pluginSdk": "^1.0.0"
  },
  "content": {
    "root": "contents",
    "index": ".vibex-plugin/content.index.json"
  },
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "providers": { "type": "array" },
        "defaultProviderId": { "type": ["string", "null"] },
        "settings": { "type": "object" }
      }
    }
  },
  "entrypoints": {
    "worker": {
      "path": "dist/worker.mjs",
      "runtime": "node",
      "protocol": "1.1"
    },
    "app": {
      "root": "dist/app",
      "document": "index.html",
      "protocol": "1.0"
    }
  },
  "integrations": [
    {
      "id": "generate-image",
      "kind": "content.skill",
      "resource": "contents/skills/generate-image"
    },
    {
      "id": "canvas-tab",
      "kind": "app.tab",
      "title": "生图画板",
      "handler": "surface.createSession",
      "allowedMethods": [
        "surface.createSession",
        "config.get",
        "config.save",
        "task.list",
        "task.save",
        "image.listProviders",
        "image.generate",
        "image.listRecords",
        "image.listAgentRecords",
        "image.getImage",
        "image.fetchModels",
        "image.testConnection",
        "storage.saveImage",
        "storage.loadImage",
        "storage.deleteImage"
      ],
      "remote": {
        "name": "vibexCanvas",
        "entry": "dist/remoteEntry.js",
        "module": "./view",
        "shared": false
      }
    }
  ]
}
