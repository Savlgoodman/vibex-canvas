{
  "manifestVersion": 4,
  "apiVersion": "1.0",
  "readme": "README.md",
  "engines": {
    "vibex": ">=0.1.3 <1.0.0",
    "pluginSdk": "^1.0.0"
  },
  "entrypoints": {
    "worker": {
      "path": "dist/worker.mjs",
      "runtime": "node",
      "protocol": "1.1"
    },
    "app": {
      "root": "dist/app",
      "document": "dist/app/index.html",
      "protocol": "1.0"
    }
  },
  "integrations": [
    {
      "id": "generate-image",
      "kind": "content.skill",
      "resource": "contents/skills/generate-image"
    },
    {
      "id": "canvas-tab",
      "kind": "app.tab",
      "title": "生图画板",
      "handler": "surface.createSession",
      "remote": {
        "name": "vibexCanvas",
        "entry": "dist/remoteEntry.js",
        "module": "./CanvasTab"
      }
    }
  ]
}
