{
  "$schema": "https://schemas.vibex.dev/plugin/v4/plugin.schema.json",
  "manifestVersion": 4,
  "apiVersion": "2.0",
  "id": "vibex-canvas",
  "publisher": "luochinwen",
  "version": "0.1.0",
  "name": "生图画板",
  "readme": "README.md",
  "engines": {
    "vibex": ">=0.1.3 <1.0.0",
    "pluginSdk": "^2.0.0"
  },
  "content": {
    "root": "contents",
    "index": ".vibex-plugin/content.index.json"
  },
  "config": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providers": { "type": "array" },
        "defaultProviderId": { "type": ["string", "null"] },
        "settings": { "type": "object" }
      }
    }
  },
  "entrypoints": {
    "worker": {
      "path": "dist/worker.mjs",
      "runtime": "node",
      "protocol": "1.1"
    },
    "app": {
      "entry": "app/main.js",
      "styles": "app/styles.css",
      "protocol": "2.0"
    }
  },
  "integrations": [
    {
      "id": "generate-image",
      "kind": "content.skill",
      "resource": "contents/skills/generate-image"
    }
  ]
}
